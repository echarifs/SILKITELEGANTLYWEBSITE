# Required in production
# MySQL connection URL, e.g. mysql://user:password@host:3306/database
# For TLS-only providers (TiDB Cloud Starter, Aiven) append: ?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Email delivery — set ONE of the two options below.
#
# Option A (recommended on Render free): Resend HTTPS API. Render free instances
# block outbound SMTP ports 25/465/587, so SMTP cannot connect there.
# The sending domain in MAIL_FROM must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=SilkItElegantly <no-reply@silkitelegantly.com>

# Option B: authenticated SMTP mailbox. Percent-encode special characters
# (e.g. @ as %40). Never commit the real value.
SMTP_URL=

# Exact public HTTPS origin used in verification/reset links.
PUBLIC_APP_ORIGIN=https://silkitelegantly.com

# Optional: port provided by most hosts automatically
PORT=3000

# Optional integrations
GOOGLE_SERVICE_ACCOUNT_JSON=
YOUCANPAY_SANDBOX_PRIVATE_KEY=
YOUCANPAY_SANDBOX_PUBLIC_KEY=
